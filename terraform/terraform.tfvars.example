# Example variable values. COPY this to terraform.tfvars and fill in real
# values. terraform.tfvars is gitignored (it holds your personal IP); this
# .example file is safe to commit and documents what inputs the stack needs.
#
#   cp terraform.tfvars.example terraform.tfvars
#   # then edit terraform.tfvars with your real IP

# REQUIRED (no default) — your public IP as a /32. Find it with:
#   curl -s ifconfig.me
# Guards SSH (22) and the Grafana/Prometheus admin UIs.
my_ip_cidr = "203.0.113.7/32"

# OPTIONAL — everything below has a sensible default in variables.tf.
# Uncomment and change only if you want to override.
# aws_region          = "eu-central-1"
# vpc_cidr            = "10.0.0.0/16"
# public_subnet_cidr  = "10.0.1.0/24"
# availability_zone   = "eu-central-1a"
# instance_type       = "t3.micro"
# ssh_public_key_path = "~/.ssh/deployer_key.pub"
