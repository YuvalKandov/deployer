# Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Terraform
# Downloaded provider plugins — huge, machine-specific
.terraform/
# State files — plaintext, may hold secrets, NEVER commit
*.tfstate
*.tfstate.*
# Crash logs
crash.log
crash.*.log
# Variable values — often secrets (a *.tfvars.example is safe to commit)
*.tfvars
*.tfvars.json
# Local-only overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# CLI config
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — it pins provider
# versions (like package-lock.json) and SHOULD be committed.
